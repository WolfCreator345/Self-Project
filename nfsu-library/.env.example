# Copy to .env.local and fill in. Never commit .env.local.

# SQLite file (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./library.db"

# Staff (Library Assistant) login — single account, no sign-up.
ADMIN_EMAIL=
# Generate with: npm run hash-password and paste the line it prints.
# Every "$" in the hash must be escaped as "\$" (the script does this for you).
ADMIN_PASSWORD_HASH=
ADMIN_NAME=

# Random 32+ byte secret, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the site (needed in production)
NEXTAUTH_URL=http://localhost:3000
