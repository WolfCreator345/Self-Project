# Copy to .env and adjust if you changed the docker-compose credentials.
# Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://consent_vault:consent_vault_dev@localhost:5432/consent_vault?schema=public"

PORT=3000

# Origin the dashboard (Vite dev server) runs on — must be an exact origin,
# not a wildcard, since cookies require CORS credentials:true.
CORS_ORIGIN="http://localhost:5173"

# Session auth (Phase 6). Users themselves are real DB rows as of Phase 8
# (multi-tenant + RBAC) — seeded by prisma/seed-database.ts, not env vars;
# see the README's Phase 8 section for the seeded demo logins.
# SESSION_SECRET: any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET="change-me-to-a-long-random-string"
